  "_comment_biome_overrides": [
    "Force villages in specific biomes to always use a given profile.",
    "Uses standard biome IDs: 'minecraft:plains', 'minecraft:taiga', etc.",
    "Modded biomes work the same way: 'byg:jacaranda_forest'",
    "Set a biome's entry to null to let the weighted random system decide.",
    "Only biomes listed here are affected — all others use weighted random."
  ],
  "biome_overrides": {
    "minecraft:beach":           "fishing_hamlet",
    "minecraft:river":           "fishing_hamlet",
    "minecraft:ocean":           "fishing_hamlet",
    "minecraft:deep_ocean":      "fishing_hamlet",
    "minecraft:frozen_ocean":    "fishing_hamlet",
    "minecraft:mushroom_fields": "apothecary_village",
    "minecraft:swamp":           "apothecary_village",
    "minecraft:mangrove_swamp":  "apothecary_village"
  },

  "_comment_village_overrides": [
    "Force a specific village to always use a specific profile.",
    "Find a village's UUID by linking it to your Trade Terminal —",
    "it appears in the terminal's detail view for that village.",
    "You can also enable debug.log_lectern_spawns in server.toml",
    "and the UUID will be printed to the server log when the lectern spawns.",
    "",
    "FORMAT:",
    "  'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx': 'profile_name'",
    "",
    "Replace the example datawith real UUIDs."
  ],
  "village_overrides": {
    "_example_note": "Replace the entry below with a real UUID from your world",
    "00000000-0000-0000-0000-000000000000": "military_garrison"
  }

