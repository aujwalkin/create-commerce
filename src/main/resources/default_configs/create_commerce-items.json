  "_comment_intro": [
    "CREATE: COMMERCE — ITEM CONFIG",
    "",
    "COIN DENOMINATIONS (Create Numismatics):",
    "  Spur=1 | Bevel=8 | Sprocket=16 | Cog=64 | Crown=512 | Sun=4096",
    "",
    "HOW VALUES WORK:",
    "  payout_spurs: how many spur-equivalents one BATCH pays out.",
    "  For stackable items (input_amount=64): this is per full stack.",
    "  For non-stackable items (input_amount=1): this is per single item.",
    "",
    "VALUE LADDER (per stack of 64, or per item for non-stackable):",
    "  Copper:    4 spurs/stack  (abundant, easy to automate)",
    "  Coal:      8 spurs/stack  (primary fuel)",
    "  Iron:     16 spurs/stack  (bulk industrial metal)",
    "  Gold:     24 spurs/stack  (farmable via piglins, but harder)",
    "  Redstone: 12 spurs/stack  (common underground)",
    "  Lapis:    16 spurs/stack  (less common, enchanting)",
    "  Quartz:   16 spurs/stack  (nether mineral)",
    "  Diamond:  64 spurs/stack  (1 COG — non-renewable, rare)",
    "  Emerald:  REFUSED         (currency exploit loop)",
    "",
    "MOD SECTIONS:",
    "  Each mod's items are grouped under its namespace key.",
    "  This makes each section collapsible in editors like Notepad++.",
    "  Items inside must use their full ID (e.g. 'minecraft:coal').",
    "  Auto-detected items are always written into nested mod groups.",
    "  Flat entries (e.g. \"minecraft:coal\":{...}) at the top level also work."
  ],
